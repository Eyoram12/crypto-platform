<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Deposit | CryptoVault</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b1020;
            color: white;
            min-height: 100vh;
        }

        header {
            background: #151c32;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        header a {
            color: white;
            text-decoration: none;
            background: #4f8cff;
            padding: 10px 18px;
            border-radius: 7px;
        }

        .container {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
        }

        .card {
            background: #151c32;
            padding: 35px;
            border-radius: 15px;
        }

        h1 {
            text-align: center;
            margin-bottom: 10px;
        }

        .description {
            text-align: center;
            color: #aab3c5;
            margin-bottom: 30px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        select,
        input {
            width: 100%;
            padding: 13px;
            margin-bottom: 20px;
            border: 1px solid #35405f;
            border-radius: 8px;
            background: #0f1629;
            color: white;
            font-size: 15px;
        }

        .address {
            background: #202a45;
            padding: 18px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .address strong {
            display: block;
            margin-bottom: 8px;
        }

        .warning {
            color: #ffcc66;
            font-size: 13px;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #4f8cff;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #3677e8;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #6ea0ff;
            text-decoration: none;
        }

        .demo {
            text-align: center;
            margin-top: 25px;
            color: #8f9ab0;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">CryptoVault</div>
        <a href="dashboard.html">Dashboard</a>
    </header>

    <div class="container">

        <div class="card">

            <h1>Deposit Crypto</h1>

            <p class="description">
                Select a cryptocurrency and enter the amount you want to deposit.
            </p>

            <form action="dashboard.html">

                <label for="crypto">Cryptocurrency</label>

                <select id="crypto" name="crypto" required>
                    <option value="">Select cryptocurrency</option>
                    <option value="BTC">Bitcoin (BTC)</option>
                    <option value="ETH">Ethereum (ETH)</option>
                    <option value="USDT">Tether (USDT)</option>
                </select>

                <div class="address">
                    <strong>Demo Deposit Address</strong>

                    <p>
                        0xDEMO1234567890CRYPTOADDRESS
                    </p>

                    <br>

                    <p class="warning">
                        ⚠️ Demonstration address only.
                        Do not send real cryptocurrency to this address.
                    </p>
                </div>

                <label for="amount">Deposit Amount</label>

                <input
                    type="number"
                    id="amount"
                    name="amount"
                    placeholder="Enter amount"
                    min="0"
                    step="any"
                    required
                >

                <button type="submit">
                    Submit Deposit Request
                </button>

            </form>

            <a class="back" href="dashboard.html">
                ← Back to Dashboard
            </a>

            <p class="demo">
                Demo platform only. No real cryptocurrency is processed.
            </p>

        </div>

    </div>

</body>

</html>
