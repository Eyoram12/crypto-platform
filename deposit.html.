<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Deposit | CryptoVault</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #07111f;
            color: #ffffff;
        }

        .header {
            background: #091522;
            border-bottom: 1px solid #203349;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav {
            width: 92%;
            max-width: 1200px;
            margin: auto;
            min-height: 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .logo span {
            color: #35d0ba;
        }

        .dashboard {
            color: #35d0ba;
            text-decoration: none;
            font-weight: bold;
        }

        .container {
            width: 92%;
            max-width: 950px;
            margin: 40px auto;
        }

        .title {
            margin-bottom: 25px;
        }

        .title h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .title p {
            color: #8fa2b6;
        }

        .warning {
            padding: 16px;
            border-radius: 10px;
            background: #2b2111;
            border: 1px solid #65501e;
            color: #f2d37b;
            line-height: 1.6;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 22px;
        }

        .card {
            background: #0d1b2a;
            border: 1px solid #203349;
            border-radius: 16px;
            padding: 25px;
        }

        .card h2 {
            font-size: 19px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            color: #dce7f2;
            font-size: 14px;
            margin-bottom: 8px;
        }

        select,
        input {
            width: 100%;
            padding: 14px;
            background: #091522;
            color: #ffffff;
            border: 1px solid #2a3e55;
            border-radius: 9px;
            font-size: 14px;
            outline: none;
        }

        select:focus,
        input:focus {
            border-color: #35d0ba;
        }

        .address-box {
            display: flex;
            gap: 8px;
        }

        .address-box input {
            flex: 1;
            font-size: 12px;
        }

        .copy-btn {
            border: 1px solid #35d0ba;
            background: transparent;
            color: #35d0ba;
            border-radius: 9px;
            padding: 0 14px;
            cursor: pointer;
        }

        .copy-btn:hover {
            background: #35d0ba;
            color: #07111f;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 9px;
            background: #35d0ba;
            color: #06121f;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .info {
            margin-bottom: 20px;
        }

        .info:last-child {
            margin-bottom: 0;
        }

        .info strong {
            display: block;
            margin-bottom: 7px;
        }

        .info p {
            color: #8fa2b6;
            font-size: 13px;
            line-height: 1.6;
        }

        .steps {
            list-style: none;
            counter-reset: steps;
        }

        .steps li {
            counter-increment: steps;
            position: relative;
            padding-left: 38px;
            margin-bottom: 18px;
            color: #9caec1;
            line-height: 1.5;
            font-size: 13px;
        }

        .steps li::before {
            content: counter(steps);
            position: absolute;
            left: 0;
            top: 0;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            background: #13283a;
            color: #35d0ba;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .demo-balance {
            padding: 15px;
            margin-top: 20px;
            border-radius: 10px;
            background: #102437;
            border: 1px solid #25445e;
        }

        .demo-balance span {
            display: block;
            color: #8fa2b6;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .demo-balance strong {
            font-size: 20px;
            color: #35d0ba;
        }

        .notice {
            margin-top: 25px;
            text-align: center;
            color: #718398;
            font-size: 12px;
            line-height: 1.6;
        }

        footer {
            text-align: center;
            color: #64768a;
            font-size: 12px;
            padding: 30px 15px;
        }

        @media (max-width: 800px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .title h1 {
                font-size: 28px;
            }
        }

        @media (max-width: 500px) {
            .address-box {
                flex-direction: column;
            }

            .copy-btn {
                padding: 12px;
            }

            .card {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

<header class="header">

    <nav class="nav">

        <div class="logo">
            Crypto<span>Vault</span>
        </div>

        <a href="dashboard.html" class="dashboard">
            Dashboard
        </a>

    </nav>

</header>


<main class="container">

    <section class="title">

        <h1>Deposit Crypto</h1>

        <p>
            Add funds to your CryptoVault demo portfolio.
        </p>

    </section>


    <div class="warning">

        <strong>Demo Safety Notice:</strong>
        Do not send real cryptocurrency to the address shown on this page.
        This is a demonstration interface only and does not process real deposits.

    </div>


    <section class="grid">

        <div class="card">

            <h2>Deposit Request</h2>

            <form action="dashboard.html" method="get">

                <div class="form-group">

                    <label for="asset">
                        Select Asset
                    </label>

                    <select id="asset" name="asset">

                        <option value="BTC">
                            Bitcoin (BTC)
                        </option>

                        <option value="ETH">
                            Ethereum (ETH)
                        </option>

                        <option value="USDT">
                            Tether (USDT)
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="address">
                        Demo Deposit Address
                    </label>

                    <div class="address-box">

                        <input
                            type="text"
                            id="address"
                            value="0xDEMO1234567890CRYPTOADDRESS"
                            readonly
                        >

                        <button
                            type="button"
                            class="copy-btn"
                            onclick="copyAddress()"
                        >
                            Copy
                        </button>

                    </div>

                </div>


                <div class="form-group">

                    <label for="amount">
                        Deposit Amount
                    </label>

                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        placeholder="Enter demo amount"
                        min="0"
                        step="any"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn"
                >
                    Submit Demo Deposit
                </button>

            </form>

        </div>


        <div class="card">

            <h2>How It Works</h2>

            <ol class="steps">

                <li>
                    Select the cryptocurrency you want to deposit.
                </li>

                <li>
                    Review the demo deposit address.
                </li>

                <li>
                    Enter a demonstration amount.
                </li>

                <li>
                    Submit the demo request.
                </li>

            </ol>


            <div class="demo-balance">

                <span>
                    Current Demo Portfolio
                </span>

                <strong>
                    $10,000.00
                </strong>

            </div>

        </div>

    </section>


    <div class="notice">

        This page is for UI demonstration only.
        A production deposit system requires secure backend processing,
        wallet infrastructure, transaction verification, and network validation.

    </div>

</main>


<footer>

    © 2026 CryptoVault. Demo platform for educational purposes.

    <br><br>

    No real cryptocurrency is accepted or transferred through this website.

</footer>


<script>

    function copyAddress() {

        const address =
            document.getElementById("address");

        navigator.clipboard.writeText(address.value)
            .then(function() {

                const button =
                    document.querySelector(".copy-btn");

                const original =
                    button.textContent;

                button.textContent = "Copied!";

                setTimeout(function() {
                    button.textContent = original;
                }, 1500);

            })
            .catch(function() {

                alert("Copy is not available in this browser.");

            });
    }

</script>

</body>
</html>
