<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Deposit | CryptoVault</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #080d1c;
            color: white;
            line-height: 1.6;
        }

        header {
            background: #11182c;
            border-bottom: 1px solid #273252;
        }

        .nav {
            max-width: 1100px;
            margin: auto;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: #6ea0ff;
            font-size: 25px;
            font-weight: bold;
        }

        .nav a {
            color: white;
            text-decoration: none;
        }

        .container {
            max-width: 650px;
            margin: 50px auto;
            padding: 0 25px;
        }

        .box {
            background: #11182c;
            border: 1px solid #273252;
            border-radius: 15px;
            padding: 35px;
        }

        h1 {
            text-align: center;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #9da8bb;
            margin-bottom: 30px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        select,
        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 22px;
            border: 1px solid #344263;
            border-radius: 8px;
            background: #0b1020;
            color: white;
            font-size: 15px;
        }

        .address-box {
            background: #0b1020;
            border: 1px solid #344263;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 22px;
            word-break: break-all;
            color: #8fb2ff;
        }

        .warning {
            background: #2b2412;
            border: 1px solid #66531e;
            color: #e8c86a;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 25px;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 8px;
            background: #4f8cff;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.9;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #6ea0ff;
            text-decoration: none;
        }

        .notice {
            text-align: center;
            color: #78859d;
            font-size: 13px;
            margin-top: 25px;
        }

        @media (max-width: 600px) {
            .nav {
                flex-direction: column;
                gap: 12px;
            }

            .box {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <header>

        <div class="nav">

            <div class="logo">
                CryptoVault
            </div>

            <a href="dashboard.html">
                ← Dashboard
            </a>

        </div>

    </header>


    <main class="container">

        <div class="box">

            <h1>
                Deposit Crypto
            </h1>

            <p class="subtitle">
                Add digital assets to your demo portfolio
            </p>


            <div class="warning">
                ⚠️ <strong>Demo Platform:</strong>
                Do not send real cryptocurrency to this address.
                This website does not process real deposits.
            </div>


            <form action="dashboard.html" method="get">

                <label for="asset">
                    Select Cryptocurrency
                </label>

                <select id="asset" name="asset" required>

                    <option value="">
                        Choose an asset
                    </option>

                    <option value="BTC">
                        Bitcoin (BTC)
                    </option>

                    <option value="ETH">
                        Ethereum (ETH)
                    </option>

                    <option value="USDT">
                        Tether (USDT)
                    </option>

                </select>


                <label>
                    Demo Deposit Address
                </label>

                <div class="address-box">
                    0xDEMO1234567890CRYPTOADDRESS
                </div>


                <label for="amount">
                    Deposit Amount
                </label>

                <input
                    type="number"
                    id="amount"
                    name="amount"
                    placeholder="Enter amount"
                    min="0"
                    step="any"
                    required
                >


                <button type="submit">
                    Submit Deposit Request
                </button>

            </form>


            <a href="dashboard.html" class="back">
                ← Back to Dashboard
            </a>

        </div>


        <p class="notice">
            CryptoVault Demo Platform. No real cryptocurrency or money is processed.
        </p>

    </main>

</body>

</html>
