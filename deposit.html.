<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deposit | CryptoVault</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b1020;
            color: white;
            min-height: 100vh;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 7%;
            background: #11182d;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        header a {
            color: white;
            text-decoration: none;
        }

        .container {
            width: 90%;
            max-width: 600px;
            margin: 50px auto;
        }

        .box {
            background: #151e38;
            padding: 30px;
            border-radius: 15px;
        }

        h1 {
            margin-bottom: 10px;
        }

        .description {
            color: #aeb8d0;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        label {
            display: block;
            margin: 15px 0 7px;
        }

        select,
        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #35405f;
            border-radius: 7px;
            background: #0b1020;
            color: white;
            font-size: 15px;
        }

        .address {
            margin-top: 20px;
            padding: 18px;
            background: #0b1020;
            border-radius: 8px;
            word-break: break-all;
            color: #aeb8d0;
        }

        .address strong {
            display: block;
            color: white;
            margin-bottom: 8px;
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 25px;
            border: none;
            border-radius: 7px;
            background: #4f7cff;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .back {
            text-align: center;
            margin-top: 20px;
        }

        .back a {
            color: #6f94ff;
            text-decoration: none;
        }
    </style>
</head>

<body>

<header>
    <div class="logo">CryptoVault</div>
    <a href="dashboard.html">Dashboard</a>
</header>

<div class="container">

    <div class="box">

        <h1>Deposit Crypto</h1>

        <p class="description">
            Select a cryptocurrency and enter the amount for your deposit request.
        </p>

        <label for="crypto">Cryptocurrency</label>

        <select id="crypto">
            <option>Bitcoin (BTC)</option>
            <option>Ethereum (ETH)</option>
            <option>USDT</option>
        </select>

        <div class="address">
            <strong>Demo Deposit Address</strong>
            This is a demonstration address. Do not send real cryptocurrency to this address.
        </div>

        <label for="amount">Deposit Amount</label>

        <input
            type="number"
            id="amount"
            placeholder="Enter amount"
            min="0"
            step="any"
        >

        <button type="button">
            Submit Deposit Request
        </button>

        <div class="back">
            <a href="dashboard.html">Back to Dashboard</a>
        </div>

    </div>

</div>

</body>
</html>
